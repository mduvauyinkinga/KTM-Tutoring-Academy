/* ---------------------------------- 24. UTILITIES
------------------------------------ */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Reduced motion preference */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0ms !important;
    transition-duration: 0ms !important;
  }
}
/* ---------------------------------- 23. RESPONSIVE BREAKPOINTS
------------------------------------ */
@media (max-width: 1024px) {
  :root {
    --sidebar-width: 200px;
    --header-height: 56px;
  }

  .navbar .nav-actions {
    width: var(--sidebar-width);
  }

  .nav-links {
    display: none;
  }

  .hamburger {
    display: flex;
  }
}

@media (max-width: 768px) {
  :root {
    --header-height: 60px;
  }

  .section {
    padding-block: var(--space-6);
  }

  .mdu-section {
    padding-block: var(--space-4);
  }

  .footer__grid {
    grid-template-columns: 1fr;
  }
}
/* ---------------------------------- 22. LEGAL PAGES
------------------------------------ */
.mdu-legal-page {
  max-width: 1000px;
  margin: 0 auto;
  padding-block: var(--space-16);
}

.mdu-legal-card {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
}

.mdu-legal-card h1,
.mdu-legal-card h2 {
  margin-top: var(--space-8);
}

.mdu-legal-card h2 {
  font-size: var(--text-xl);
  margin-bottom: var(--space-3);
}

.mdu-legal-card p,
.mdu-legal-card li {
  line-height: 1.7;
  color: var(--color-text-primary);
}

.mdu-legal-card ul {
  padding-left: var(--space-5);
  margin-bottom: var(--space-4);
}

.mdu-legal-card li {
  margin-bottom: var(--space-2);
}

.mdu-legal-note {
  margin-top: var(--space-6);
  padding-top: var(--space-5);
  border-top: 1px solid var(--color-border);
  font-size: var(--text-sm);
  opacity: 0.8;
}
/* ---------------------------------- 21. FOOTER
------------------------------------ */
.footer {
  background: var(--color-bg-secondary);
  border-top: 1px solid var(--color-border);
  margin-top: var(--space-16);
}

.footer__container {
  padding-block: var(--space-10);
}

.footer__head {
  font-size: var(--text-base);
  font-weight: 800;
  color: var(--color-text-primary);
  margin-bottom: var(--space-3);
}

.footer__grid {
  display: grid;
  gap: var(--space-5);
  margin-bottom: var(--space-6);
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.footer__group h4 {
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: var(--space-3);
}

.footer__group p,
.footer__group a {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.footer__group a:hover {
  color: var(--color-accent);
}

.footer__legal {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.footer__copyright {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}
/* ---------------------------------- 20. TABLES
------------------------------------ */
.table {
  width: 100%;
  border-collapse: collapse;
}

.table th,
.table td {
  padding: var(--space-3, 1rem) var(--space-4, 1rem);
  border-bottom: 1px solid var(--color-border);
  font-size: var(--text-sm);
}

.table th {
  font-weight: 600;
  color: var(--color-text-secondary);
  text-align: left;
}

.table tr:hover td {
  background: var(--color-accent-light);
}
/* ---------------------------------- 19. NOTIFICATION INDICATOR
------------------------------------ */
.notification-indicator {
  position: relative;
}

.notification-indicator__count {
  position: absolute;
  top: var(--space-1, 0.25rem);
  right: var(--space-1, 0.25rem);
  min-width: var(--space-3, 0.75rem);
  padding: var(--space-1, 0.25rem) var(--space-2, 0.5rem);
  font-size: var(--text-xxxs, 0.65rem);
  font-weight: 700;
  color: var(--color-text-inverse);
  background: var(--color-error);
  border-radius: var(--radius-full);
}
/* ---------------------------------- 18. BREADCRUMB
------------------------------------ */
.breadcrumb {
  padding: var(--space-3, 1rem) 0;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  list-style: none;
  background: var(--color-accent-light);
  border-radius: var(--radius-md);
}

.breadcrumb__item {
  display: inline;
  margin-right: var(--space-3, 0.75rem);
}

.breadcrumb__item:not(:last-child)::after {
  content: '/';
  margin-left: var(--space-2, 0.5rem);
  color: var(--color-text-secondary);
}
/* ---------------------------------- 17. PROGRESS INDICATORS
------------------------------------ */
.progress {
  width: 100%;
  height: var(--space-2, 0.5rem);
  background: var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress__bar {
  height: 100%;
  background: var(--color-accent);
  width: 0%;
  transition: width var(--duration-normal) var(--ease-out);
}
/* ---------------------------------- 16. ERROR STATES
------------------------------------ */
.error-state {
  padding: var(--space-10);
  text-align: center;
  color: var(--color-error);
}

.error-state svg {
  width: 48px;
  height: 48px;
  margin: 0 auto var(--space-4);
  opacity: 0.5;
}
/* ---------------------------------- 15. EMPTY STATES
------------------------------------ */
.empty-state {
  text-align: center;
  color: var(--color-text-secondary);
}

.empty-state svg {
  width: 40px;
  height: 40px;
  margin: 0 auto var(--space-4);
  opacity: 0.5;
}

.empty-state h3 {
  font-size: var(--text-base);
  margin-bottom: var(--space-1);
  color: var(--color-text-primary);
}
/* ---------------------------------- 14. LOADING STATES
------------------------------------ */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
}

.loading.hidden {
  display: none;
}

.spinner {
  width: 24px;
  height: 24px;
  border: 2px solid var(--color-border);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
/* ---------------------------------- 13. MODAL AND SIDE-PANEL LAYOUTS
------------------------------------ */
.side-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 320px;
  max-width: 100%;
  background: var(--color-card);
  box-shadow: var(--shadow-lg);
  z-index: 200;
  transform: translateX(100%);
  transition: transform var(--duration-normal) var(--ease-out);
  padding: var(--space-6, 1.5rem);
}

.side-panel--open {
  transform: translateX(0);
}

.side-panel__overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(4px);
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--duration-fast) var(--ease-out),
    visibility var(--duration-fast) var(--ease-out);
  z-index: 190;
}

.side-panel--open .side-panel__overlay {
  opacity: 1;
  visibility: visible;
}
/* ---------------------------------- 12. NAVIGATION INDICATORS
------------------------------------ */
.position-indicator {
  display: inline-block;
  margin-left: var(--space-1, 0.25rem);
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
  background: var(--color-text-secondary);
  vertical-align: middle;
  animation: pulse 2s infinite;
}

.position-indicator--active {
  background: var(--color-accent);
  animation: none;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}
/* ---------------------------------- 11. DROPDOWN
------------------------------------ */
.dropdown {
  position: relative;
  display: inline-block;
}

.dropdown__trigger {
  display: flex;
  align-items: center;
  gap: var(--space-2, 0.5rem);
  padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
  font-size: var(--text-sm);
  color: var(--color-text-primary);
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: border-color var(--duration-fast) var(--ease-out);
}

.dropdown__trigger:hover {
  border-color: var(--color-accent);
}

.dropdown__menu {
  position: absolute;
  top: 100%;
  right: 0;
  margin-top: var(--space-1, 0.25rem);
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  min-width: 180px;
  padding: var(--space-3, 0.75rem) 0;
  box-shadow: var(--shadow-md);
  list-style: none;
  z-index: 100;
  display: none;
}

.dropdown--open .dropdown__menu {
  display: block;
}

.dropdown__menu li {
  padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
  font-size: var(--text-sm);
  cursor: pointer;
}

.dropdown__menu li:hover {
  background: var(--color-accent-light);
  color: var(--color-accent);
}
/* ---------------------------------- 10. SIDE AUTH PANELS
------------------------------------ */
.modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 400px;
  max-width: 100%;
  background: var(--color-card);
  box-shadow: var(--shadow-lg);
  transform: translateX(100%);
  transition: transform var(--duration-normal) var(--ease-out);
  z-index: 200;
  display: flex;
  flex-direction: column;
}

.modal--open .modal {
  transform: translateX(0);
}

.modal__overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--duration-fast) var(--ease-out),
    visibility var(--duration-fast) var(--ease-out);
  z-index: 190;
}

.modal--open .modal__overlay {
  opacity: 1;
  visibility: visible;
}

.modal__dialog {
  width: 100%;
  max-width: 100%;
  padding: var(--space-6, 1.5rem);
  display: flex;
  flex-direction: column;
  gap: var(--space-6, 1.5rem);
}

.side-auth-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--color-border);
}

.side-auth-header__title {
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.modal__close {
  width: var(--space-8, 2rem);
  height: var(--space-8, 2rem);
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
  color: var(--color-text-secondary);
  font-size: var(--text-xl);
  line-height: 1;
}

.modal__close:hover {
  color: var(--color-text-primary);
}

.side-auth-tab {
  padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text-secondary);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  cursor: pointer;
  transition: color var(--duration-fast) var(--ease-out),
    background var(--duration-fast) var(--ease-out);
  white-space: nowrap;
}

.side-auth-tab.active {
  color: var(--color-accent);
  background: var(--color-accent-light);
}

.side-auth-tab:not(.active):hover {
  color: var(--color-text-primary);
}

.side-auth-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.side-auth-form .field__label {
  font-size: var(--text-sm);
  font-weight: 500;
}

.side-auth-form .field__input {
  font-size: var(--text-base);
}
/* ---------------------------------- 9. NAVIGATION ELEMENTS
------------------------------------ */
.navbar {
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--header-height);
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: var(--space-3, 0.75rem);
}

.nav-brand__text {
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.nav-wrapper {
  display: flex;
  align-items: center;
  gap: var(--space-6, 1.5rem);
}

.nav-links {
  display: flex;
  gap: var(--space-6, 1.5rem);
}

.nav-links__link {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-secondary);
  position: relative;
}

.nav-links__link:hover {
  color: var(--color-text-primary);
}

.nav-links__link.active {
  color: var(--color-accent);
}

.nav-links__link.active::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 100%;
  height: 2px;
  background: var(--color-accent);
}

/* Mobile menu */
.hamburger {
  display: none;
  flex-direction: column;
  gap: var(--space-1, 0.25rem);
  background: transparent;
  border: none;
  padding: var(--space-2, 0.5rem);
  cursor: pointer;
}

.hamburger span {
  width: 24px;
  height: 2px;
  background: var(--color-text-primary);
  transition: transform var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
}

.hamburger.active span:nth-child(1) {
  transform: rotate(45deg) translate(5px, 5px);
}

.hamburger.active span:nth-child(2) {
  opacity: 0;
}

.hamburger.active span:nth-child(3) {
  transform: rotate(-45deg) translate(5px, -5px);
}

.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--duration-fast) var(--ease-out),
    visibility var(--duration-fast) var(--ease-out);
}

.menu-overlay.active {
  opacity: 1;
  visibility: visible;
}

.mobile-menu {
  position: fixed;
  top: var(--header-height);
  left: 0;
  bottom: 0;
  width: var(--sidebar-width);
  max-width: var(--sidebar-width);
  background: var(--color-bg);
  transform: translateX(-100%);
  transition: transform var(--duration-normal) var(--ease-out);
  z-index: 100;
}

.mobile-menu.active {
  transform: translateX(0);
}

.mobile-menu .nav-links {
  flex-direction: column;
  padding: var(--space-6, 1.5rem);
  gap: var(--space-3, 0.75rem);
}

/* Navbar actions */
.navbar .nav-actions {
  position: absolute;
  right: 0;
  top: var(--header-height);
  flex-direction: column;
  width: var(--sidebar-width);
  background: var(--color-bg);
  border-left: 1px solid var(--color-border);
  padding: var(--space-6, 1.5rem);
  transform: translateX(100%);
  transition: transform var(--duration-normal) var(--ease-out);
}

.navbar .nav-actions.active {
  transform: translateX(0);
}
/* ---------------------------------- 8. CARDS
------------------------------------ */
.card {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.card__header {
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--color-border);
}

.card__title {
  font-size: var(--text-lg);
  font-weight: 600;
  margin-bottom: 0;
}

.card__body {
  padding: var(--space-5) var(--space-5) 0;
}

.card__footer {
  padding: var(--space-4) var(--space-5);
  border-top: 1px solid var(--color-border);
}
/* ---------------------------------- 6. BUTTONS
------------------------------------ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-3, 1rem) var(--space-5, 1.25rem);
  font-size: var(--text-base);
  font-weight: 600;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-out);
  white-space: nowrap;
}

.btn--primary {
  background: var(--color-accent);
  color: var(--color-text-inverse);
}

.btn--primary:hover {
  background: #1d4ed8;
  transform: translateY(-1px);
}

.btn--primary:active {
  transform: translateY(0);
}

.btn--outline {
  background: transparent;
  color: var(--color-text-primary);
  border: 1px solid var(--color-border);
}

.btn--outline:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.btn--secondary {
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
  border: 1px solid var(--color-border);
}

.btn--secondary:hover {
  background: var(--color-border);
}

.btn--lg {
  padding: var(--space-4, 1rem) var(--space-6, 1.5rem);
  font-size: var(--text-lg);
}

.btn--sm {
  padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
  font-size: var(--text-sm);
}

.btn--block {
  width: 100%;
}

/* ---------------------------------- 7. FORM CONTROLS
------------------------------------ */
.field {
  margin-bottom: var(--space-4);
}

.field__label {
  display: block;
  font-size: var(--text-sm);
  font-weight: 600;
  margin-bottom: var(--space-1);
  color: var(--color-text-primary);
}

.field__input {
  width: 100%;
  padding: var(--space-3, 1rem) var(--space-4, 1rem);
  font-size: var(--text-base);
  font-family: var(--font-stack);
  color: var(--color-text-primary);
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  transition: border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

.field__input:focus {
  border-color: var(--color-accent);
  outline: none;
  box-shadow: 0 0 0 3px var(--color-accent-light);
}

.field__input::placeholder {
  color: var(--color-text-secondary);
  opacity: 0.6;
}

.field__checkbox {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2, 0.5rem);
  cursor: pointer;
  padding: 0;
}

.field__checkbox input {
  width: auto;
  height: auto;
  cursor: pointer;
}

.field__hint {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-top: var(--space-2, 0.5rem);
}

/* Show/hide password toggle */
.password-toggle {
  position: relative;
}

.password-toggle__btn {
  position: absolute;
  right: var(--space-3, 1rem);
  background: transparent;
  border: none;
  color: var(--color-text-secondary);
  padding: var(--space-2, 0.5rem);
  cursor: pointer;
  font-size: var(--text-lg);
  line-height: 1;
}

.password-toggle__btn:hover {
  color: var(--color-text-primary);
}
/* ---------------------------------- 3. TYPOGRAPHY
------------------------------------ */
h1,
h2,
h3,
h4,
h5,
h6 {
  margin: 0;
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: var(--heading-line-height);
  letter-spacing: var(--heading-letter-spacing);
  color: var(--color-text-primary);
}

h1 { font-size: var(--text-4xl); }
h2 { font-size: var(--text-3xl); }
h3 { font-size: var(--text-2xl); }
h4 { font-size: var(--text-xl); }
h5 { font-size: var(--text-lg); }
h6 { font-size: var(--text-base); }

p {
  margin: 0 0 var(--space-4);
  font-size: var(--text-base);
  line-height: var(--body-line-height);
  color: var(--color-text-primary);
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease-out);
}

a:hover {
  color: var(--color-accent);
}

ul,
ol {
  margin: 0;
  padding-left: var(--space-6);
}

li {
  list-style: none;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* ---------------------------------- 4. SPACING UTILITIES
------------------------------------ */
.mdu-container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--container-padding);
}

.section {
  padding-block: var(--space-10);
}

.section--compact {
  padding-block: var(--space-6);
}

.mdu-section {
  padding-block: var(--space-8);
}

.mdu-section--spacious {
  padding-block: var(--space-12);
}

.mdu-section--centered {
  text-align: center;
}

/* ---------------------------------- 5. BADGES
------------------------------------ */
.badge {
  display: inline-flex;
  align-items: center;
  padding: var(--space-1, 0.25rem) var(--space-2, 0.5rem);
  font-size: var(--text-sm);
  font-weight: 600;
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.badge--primary {
  background: var(--color-accent);
  color: var(--color-text-inverse);
}

.badge--subtle {
  background: var(--color-accent-light);
  color: var(--color-accent);
  border: 1px solid var(--color-border);
}

.badge--outline {
  background: transparent;
  color: var(--color-accent);
  padding: var(--space-1, 0.25rem) var(--space-2, 0.5rem);
  border: 1px solid var(--color-accent);
  border-radius: var(--radius-full);
}
/* ---------------------------------- 2. BASE & LAYOUT
------------------------------------ */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 100%;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text-primary);
  font-family: var(--font-stack);
  font-size: var(--text-base);
  line-height: var(--body-line-height);
}

/* Focus visible outline for accessibility */
button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

/* Prevent iOS text size adjustments */
@media screen and (max-width: 768px) {
  html {
    -webkit-text-size-adjust: 100%;
  }
}
/* KTM Academy Global Design System v2.0 */

/* ---------------------------------- 1. CSS CUSTOM PROPERTIES ------------------------------------ */
:root {
  /* Brand palette -- KTM Academy primary colors */
  --color-bg: #ffffff;
  --color-bg-secondary: #f8fafc;
  --color-card: #ffffff;
  --color-text-primary: #17243a;
  --color-text-secondary: #64748b;
  --color-accent: #2563eb;
  --color-accent-light: #eff6ff;
  --color-border: #e2e8f0;
  --color-success: #16a34a;
  --color-warning: #d97706;
  --color-error: #dc2626;

  /* Semantic extensions */
  --color-text-inverse: #ffffff;
  --color-bg-elevated: #ffffff;
  --color-border-subtle: rgba(226, 232, 240, 0.7);
  --color-accent-soft: #eff6ff;
  --color-success-soft: #f0fdf4;
  --color-warning-soft: #fffbeb;
  --color-error-soft: #fef2f2;
  --color-shadow: rgba(15, 23, 42, 0.06);

  /* Typography */
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji",
    "Segoe UI Emoji", "Noto Color Emoji";
  --font-heading: var(--font-stack);
  --font-ui: var(--font-stack);

  --text-xs: 0.75rem;
  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.25rem;
  --text-2xl: 1.5rem;
  --text-3xl: 1.875rem;
  --text-4xl: 2.25rem;

  --heading-letter-spacing: 0.01em;
  --body-line-height: 1.6;
  --heading-line-height: 1.2;

  /* Spacing */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --space-20: 5rem;
  --space-24: 6rem;

  /* Border radius */
  --radius-sm: 0.25rem;
  --radius-base: 0.375rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-xl: 1rem;
  --radius-full: 9999px;

  /* Shadows */
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-base: 0 1px 3px rgba(15, 23, 42, 0.06),
    0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 10px 30px rgba(15, 23, 42, 0.1);
  --shadow-xl: 0 20px 50px rgba(15, 23, 42, 0.12);

  /* Motion */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --duration-fast: 120ms;
  --duration-normal: 200ms;
  --duration-slow: 320ms;

  /* Layout helpers */
  --sidebar-width: 240px;
  --header-height: 64px;
  --max-width: 1200px;
  --container-padding: 1rem;
}

/* Dark mode is NOT part of this design phase. Default is light. */
html {
  color-scheme: light;
}