rules_version = '2';

service cloud.firestore {
  function isAdmin() {
    // Set via Firebase Custom Claims: admin=true (see server/assignAdminClaim.js)
    return request.auth != null && request.auth.token.admin == true;
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function hasPaidAccess() {
    let userPath = /databases/(default)/documents/users/$(request.auth.uid);
    return request.auth != null
      && exists(userPath)
      && get(userPath).data.isPaid == true
      && get(userPath).data.paidAccessUntil is timestamp
      && get(userPath).data.paidAccessUntil > request.time;
  }

  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // USERS
    // Clients may only CREATE their own profile at registration.
    // plan / isPaid / role / trialUsed are server-controlled: they are
    // written only by the Paystack webhook via Firebase Admin SDK,
    // which bypasses these rules. Clients can NEVER update them.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.plan == 'trial'
        && request.resource.data.isPaid == false
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'grade', 'role', 'plan', 'isPaid',
          'trialUsed', 'privacyConsentAccepted',
          'privacyConsentAcceptedAt', 'createdAt'
        ]);

      allow update, delete: if isAdmin();
    }

    // Payments ledger: written only by the webhook server (Admin SDK).
    match /payments/{reference} {
      allow read, write: if isAdmin();
    }

    // Admin uploads (legacy metadata collection)
    match /uploads/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // CONTENT
    // Paid access must be explicitly active and have a future paid-through date.
    // The rules enforce expiry even if the client is offline or manipulated.
    // Admin write via custom claim only.
    // ------------------------------------------------------------------
    match /lessons/{docId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.isFree == true ||
        hasPaidAccess()
      );
      allow write: if isAdmin();
    }

    match /past_papers/{docId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.isFree == true ||
        hasPaidAccess()
      );
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
